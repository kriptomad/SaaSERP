# Reverse proxy com HTTPS automático (Let's Encrypt). Variáveis vêm do serviço caddy
# do docker-compose.yml (APP_DOMAIN / API_DOMAIN, definidas no .env).
{$APP_DOMAIN} {
	encode zstd gzip
	# Container "web" agora escuta em 8080 (imagem nginx-unprivileged, sem root) —
	# ver apps/web/Dockerfile (fa-infra-web-dockerfile-no-nonroot-user).
	reverse_proxy web:8080
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3333
}
