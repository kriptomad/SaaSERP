# Copie para .env (nesta pasta) e preencha. NUNCA commitar o .env real.
# O docker compose lê automaticamente o .env ao lado do docker-compose.yml.

# --- Postgres 15 (use hex/alfanumérico: a senha entra numa URL) -------------------
# gerar: openssl rand -hex 24
POSTGRES_USER=filitech
POSTGRES_DB=filitech
POSTGRES_PASSWORD=

# --- Redis 7 (filas BullMQ + cache tenant:{id}:cache) ------------------------------
# gerar: openssl rand -hex 24
REDIS_PASSWORD=

# --- API (apps/api) ----------------------------------------------------------------
# Origens permitidas no CORS, separadas por vírgula, SEM barra final.
CORS_ORIGIN=https://app.example.com
# KEK que cifra as credenciais de integração (32 bytes em base64). gerar: openssl rand -base64 32
INTEGRATION_CREDENTIALS_MASTER_KEY=

# Billing (opcionais — deixe vazio se o provedor não for usado)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_BASE_URL=https://www.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- Web (apps/web) — lido em BUILD time pelo Vite ----------------------------------
# URL pública da API vista pelo navegador. Mudou? Rode `docker compose build web`.
VITE_API_BASE_URL=https://api.example.com

# --- Exposição de portas / HTTPS ---------------------------------------------------
# 127.0.0.1 = só local (atrás do Caddy/Nginx); 0.0.0.0 = exposto direto (sem HTTPS).
BIND_ADDRESS=127.0.0.1
# Usados apenas com `--profile https` (Caddy). DNS A/AAAA de ambos deve apontar para a VPS.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# JWT RS256: não vai no .env — coloque os arquivos em ./secrets (ver README.md):
#   secrets/jwt-private.pem e secrets/jwt-public.pem
