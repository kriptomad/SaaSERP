# Copie para .env e preencha com valores reais. NUNCA commitar o .env real.

# Ambiente — controla nível de log padrão, mensagens de erro verbosas (stack trace)
# e validações estritas no boot (ex.: exige REDIS_URL, valida CORS_ORIGIN). Valores:
# development | test | production.
# fa-w5-boot-no-central-env-validation: em produção, `apps/api/src/lib/env-validation.ts`
# roda ANTES de qualquer outra coisa (server.ts/worker.ts) e valida de uma vez só TODAS
# as variáveis obrigatórias (DATABASE_URL, REDIS_URL, JWT_*, INTEGRATION_CREDENTIALS_MASTER_KEY,
# invariante de billing) — falha o boot com a lista completa de problemas em vez de
# deixar o processo subir "meio quebrado". NO-OP fora de produção.
NODE_ENV="development"

# Nível de log do Pino (lib/logger.ts). Padrão: "debug" fora de produção, "info" em
# produção. Valores aceitos: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL="debug"

# Postgres 15 (Capítulo 3.4) — local: infra/docker/docker-compose.dev.yml; produção: Railway/Neon.
DATABASE_URL="postgresql://filitech:filitech_dev_password@localhost:5432/filitech?schema=public"

# fa-w5-perf-prisma-pool-uncapped — tamanho do pool de conexões do Prisma POR
# PROCESSO (aplicado como `connection_limit` na própria `DATABASE_URL`, lido em
# `packages/db/src/client.ts`). Opcional: sem esta variável, o Prisma usa o default
# da biblioteca (num_cpus * 2 + 1 por processo), sem nenhum teto coordenado entre
# réplicas — risco real de estourar o `max_connections` do Postgres sob carga com
# múltiplas réplicas da API + worker(s).
#
# Como dimensionar: total de conexões reais no Postgres ~= (réplicas da API +
# processos de worker) x DB_POOL_SIZE. Ex.: 3 réplicas de API + 1 processo de worker
# (4 processos no total) x DB_POOL_SIZE=20 = 80 conexões simultâneas no pior caso.
# Deixe folga para: conexões administrativas (psql, Prisma Studio, pgAdmin), a
# conexão do pooler/PgBouncer se houver, e qualquer `reserved_connections` do
# provedor gerenciado (Railway/Neon costumam reservar algumas para si mesmos).
# `max_connections` default do Postgres e comumente 100 — para esse teto, um ponto
# de partida seguro e manter o produto acima bem abaixo de 100 (ex.: ~60-80), nunca
# no limite exato. Ajuste para o `max_connections` real do seu provedor/plano.
DB_POOL_SIZE="20"

# Redis (Capítulo 3.4) — filas BullMQ (WhatsApp, relatórios), namespace tenant:{id}:cache.
# OBRIGATÓRIO quando NODE_ENV=production (o processo falha no boot sem esta variável
# em produção — nunca cai silenciosamente para localhost dentro do container).
REDIS_URL="redis://localhost:6379"

# fa-w5-notif-no-outbound-volume-cap — teto por tenant de envios externos
# (WhatsApp + SMS combinados) por hora e por dia (notify.service.ts,
# enforceTenantNotificationCap). Opcional — defaults abaixo se omitido.
TENANT_NOTIFICATION_HOURLY_CAP="500"
TENANT_NOTIFICATION_DAILY_CAP="2000"

# JWT RS256 (Capítulo 3.5) — gerar com: node apps/api/scripts/generate-jwt-keys.js
JWT_PRIVATE_KEY_PATH="./keys/jwt-private.pem"
JWT_PUBLIC_KEY_PATH="./keys/jwt-public.pem"
# Em plataformas sem arquivos secretos (Railway) use o PEM direto (aceita \n literais):
# JWT_PRIVATE_KEY=""
# JWT_PUBLIC_KEY=""

# KEK das credenciais de integração (32 bytes base64): openssl rand -base64 32
INTEGRATION_CREDENTIALS_MASTER_KEY=""

# API
PORT=3333
# Interface de bind do servidor HTTP. Padrão "0.0.0.0" (todas as interfaces); o
# Filitech ERP Desktop (modo HOST) pode definir um IP específico da LAN (ver
# apps/desktop/src/screens/HostNetworkConfig.tsx).
HOST="0.0.0.0"
# Número de "hops" de proxy reverso confiáveis à frente do processo Node (usado por
# `app.set("trust proxy", ...)`, afeta req.ip / rate-limit / AuditLog por IP).
# Railway, Vercel e o Caddy/Nginx do deploy/generic-host ficam a 1 hop — só aumente
# se houver mais de um proxy encadeado (ex.: CDN + load balancer próprios).
TRUST_PROXY_HOPS=1
# Lista de origens permitidas para CORS, separadas por vírgula (sem espaço nem barra
# final), ex.: "https://app.seudominio.com.br,https://admin.seudominio.com.br".
# EM PRODUÇÃO é OBRIGATÓRIO (pode ser definido aqui OU via painel admin/DB —
# ver lib/platform-secrets.ts): sem nenhuma origem configurada, o servidor falha
# fechado e rejeita TODA requisição de navegador (ver server.ts). O valor abaixo
# serve só para desenvolvimento local (Vite dev server).
CORS_ORIGIN="http://localhost:5173"

# Object Storage — Cloudflare R2 (Capítulo 3.3), zero egress fees.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="filitech-uploads"

# Billing — Stripe/Asaas (Capítulo 2.1)
# fa-w5-boot-optional-integrations-lazy-failure: EM PRODUÇÃO, o boot (lib/env-validation.ts)
# exige que PELO MENOS UM provedor esteja completo e bem formado (Stripe: as duas vars
# abaixo; Asaas: ASAAS_API_KEY + ASAAS_WEBHOOK_TOKEN) — sem isso, o processo falha no boot
# em vez de só no primeiro checkout de um cliente real.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Base URL da API do Asaas — padrão aponta para produção; use o sandbox em dev/teste:
# "https://api-sandbox.asaas.com/v3".
ASAAS_BASE_URL="https://www.asaas.com/api/v3"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
# Defina "true" APENAS se Stripe/Asaas são geridos EXCLUSIVAMENTE pelo painel admin
# (PlatformSecret no banco, nunca por variável de ambiente) — reconhece explicitamente
# ao validador de boot que a ausência das variáveis acima é intencional, em vez de deixar
# o processo falhar o boot por engano.
BILLING_CONFIGURED_VIA_ADMIN_PANEL=""

# WhatsApp Business API (Capítulo 20.2)
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Open Finance — Pluggy (Capítulo 17.4.1/22.5)
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Cotação de ações/FIIs (Capítulo 22.6/22.10) — brapi.dev (ver nota de desvio de
# provedor em apps/api/src/lib/brapi-client.ts). Opcional: funciona sem token com
# limite de taxa mais apertado; cadastre um token gratuito para elevar o limite.
BRAPI_API_TOKEN=""

# Sentry (rastreamento de erros/APM — fa-w4-obs-no-error-tracking-apm). OPCIONAIS: se
# ausentes, Sentry simplesmente não inicializa (no-op) em ambos os apps — não quebra
# dev local nem este sandbox, que não tem um projeto Sentry real configurado.
# Defina em PRODUÇÃO para habilitar de verdade (nenhuma mudança de código necessária).
# Backend (lib/sentry.ts, server.ts, worker.ts):
SENTRY_DSN=""
# Frontend (apps/web/src/lib/sentry.ts) — build-time var do Vite, prefixo VITE_
# obrigatório para ser exposta ao bundle do navegador:
VITE_SENTRY_DSN=""
# Desktop/Electron (apps/desktop) — ver apps/desktop/.env.example para a lista
# completa (DESKTOP_SENTRY_DSN, VITE_DESKTOP_SENTRY_DSN, CSC_LINK, CSC_KEY_PASSWORD,
# DESKTOP_UPDATE_FEED_URL).

# Métricas Prometheus (fa-w4-obs-no-metrics-endpoint — apps/api/src/lib/metrics.ts).
# OPCIONAL em dev (sem token, `/metrics` fica aberto para scraping local). Em
# PRODUÇÃO (NODE_ENV=production) é OBRIGATÓRIO para habilitar o endpoint: sem esta
# variável, `GET /metrics` responde 404 (fail-closed, nunca aberto por engano).
# Configure o scraper Prometheus para enviar `Authorization: Bearer <METRICS_TOKEN>`.
METRICS_TOKEN=""
