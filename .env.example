# Copie para .env e preencha com valores reais. NUNCA commitar o .env real.

# Postgres 15 (Capítulo 3.4) — local: infra/docker/docker-compose.dev.yml; produção: Railway/Neon.
DATABASE_URL="postgresql://filitech:filitech_dev_password@localhost:5432/filitech?schema=public"

# Redis (Capítulo 3.4) — filas BullMQ (WhatsApp, relatórios), namespace tenant:{id}:cache.
REDIS_URL="redis://localhost:6379"

# JWT RS256 (Capítulo 3.5) — gerar com: node apps/api/scripts/generate-jwt-keys.js
JWT_PRIVATE_KEY_PATH="./keys/jwt-private.pem"
JWT_PUBLIC_KEY_PATH="./keys/jwt-public.pem"
# Em plataformas sem arquivos secretos (Railway) use o PEM direto (aceita \n literais):
# JWT_PRIVATE_KEY=""
# JWT_PUBLIC_KEY=""

# KEK das credenciais de integração (32 bytes base64): openssl rand -base64 32
INTEGRATION_CREDENTIALS_MASTER_KEY=""

# API
PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Object Storage — Cloudflare R2 (Capítulo 3.3), zero egress fees.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="filitech-uploads"

# Billing — Stripe/Asaas (Capítulo 2.1)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# WhatsApp Business API (Capítulo 20.2)
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Open Finance — Pluggy (Capítulo 17.4.1/22.5)
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
